<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Secara eksplisit memblokir semua cleartext (HTTP) untuk semua domain -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>